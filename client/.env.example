# ==============================================================================
# StreamVerse Client Environment Configuration Template
# ==============================================================================
# The VITE_ prefix is required for Vite to expose variables to client-side bundle.
# In local development, the backend runs on port 5000.
# In production, set this to your deployed backend URL (e.g., https://api.streamverse.com/api)
# ==============================================================================

VITE_API_URL=http://localhost:5000/api
