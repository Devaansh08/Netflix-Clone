# ==============================================================================
# StreamVerse Server Environment Configuration Template
# ==============================================================================
# This template documents all required and optional environment variables
# needed to run the StreamVerse backend service.
#
# INTERVIEW NOTE:
# Never commit real credentials or .env files to source control. Use .env.example
# as a contract so any engineer or CI/CD runner knows exactly what config is needed.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas URI or local instance)
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/streamverse?retryWrites=true&w=majority

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin (For CORS whitelist and secure cookies)
CLIENT_URL=http://localhost:5173

# The Movie Database (TMDB) API Key - v3 Authentication Key
# Stored strictly on the backend to avoid exposing client-side credentials
TMDB_API_KEY=your_tmdb_v3_api_key_here
